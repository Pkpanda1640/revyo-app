# The public URL of your deployed site (used to build QR code links).
# Set this AFTER your first deploy, once you know your real URL or domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# From Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Login for the admin panel (choose your own values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-strong

# Any long random string — used to sign login sessions. Generate one at
# https://generate-secret.vercel.app/32 or run: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
